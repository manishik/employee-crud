          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Create one fresh CSV for this run, next to the saved JMX file.
import org.apache.jmeter.services.FileServer
import java.nio.file.Files
import java.nio.charset.StandardCharsets

def folder = new File(FileServer.getFileServer().getBaseDir(), &apos;jmeter-results&apos;)
Files.createDirectories(folder.toPath())
def stamp = new java.text.SimpleDateFormat(&apos;yyyyMMdd-HHmmss-SSS&apos;).format(new Date())
def file = new File(folder, &apos;employee-results-&apos; + stamp + &apos;-&apos; + UUID.randomUUID().toString().take(8) + &apos;.csv&apos;)
def header = &apos;timestamp_utc,endpoint,method,url,response_time_ms,status_code,success,user,error_message,row_type,samples,total_response_time_ms,elapsed_time_ms\n&apos;
Files.write(file.toPath(), header.getBytes(StandardCharsets.UTF_8), java.nio.file.StandardOpenOption.CREATE_NEW)
props.put(&apos;employee.csv.file&apos;, file.getAbsolutePath())
log.info(&apos;Combined employee CSV: &apos; + file.getAbsolutePath())
props.put(&apos;employee.csv.stats&apos;, new LinkedHashMap())
props.put(&apos;employee.csv.runStartNs&apos;, System.nanoTime())
SampleResult.setIgnore()
</stringProp>
        </JSR223Sampler>

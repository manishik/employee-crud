        <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="Write all endpoints to one CSV (Groovy)" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Runs after each request and its assertions. All users share this CSV.
import java.nio.file.Files
import java.nio.file.StandardOpenOption
import java.nio.charset.StandardCharsets

def result = sampleResult
def errors = result.getAssertionResults().findAll { it.isFailure() || it.isError() }
    .collect { it.getFailureMessage() ?: it.getName() }.join(&apos;; &apos;)
if (!result.isSuccessful() &amp;&amp; !errors) {
    errors = result.getResponseMessage()
}
def values = [java.time.Instant.ofEpochMilli(result.getStartTime()).toString(),
    result.getSampleLabel(), result.getHTTPMethod(), result.getURL().toString(),
    result.getTime(), result.getResponseCode(), result.isSuccessful(),
    result.getThreadName(), errors, &apos;REQUEST&apos;, 1, result.getTime(), &apos;&apos;]
// Label every populated duration in milliseconds; keep calculations numeric.
[4, 11, 12].each { index -&gt;
    if (values[index] != &apos;&apos;) values[index] = values[index].toString() + &apos; ms&apos;
}
// Quote every field and escape quotes so commas/newlines cannot break the CSV.
def row = values.collect { value -&gt; &apos;&quot;&apos; + (value == null ? &apos;&apos; : value.toString()).replace(&apos;&quot;&apos;, &apos;&quot;&quot;&apos;) + &apos;&quot;&apos; }.join(&apos;,&apos;) + &apos;\n&apos;
// Prevent concurrent users from interleaving writes.
synchronized (props) {
    def stats = props.get(&apos;employee.csv.stats&apos;)
    def name = result.getSampleLabel()
    if (!stats.containsKey(name)) {
        stats[name] = [count: 0L, total: 0L, first: result.getStartTime(), last: result.getEndTime(), success: true]
    }
    def entry = stats[name]
    entry.count += 1L
    entry.total += result.getTime()
    entry.first = Math.min(entry.first as long, result.getStartTime())
    entry.last = Math.max(entry.last as long, result.getEndTime())
    entry.success = entry.success &amp;&amp; result.isSuccessful()
    def file = new File(props.getProperty(&apos;employee.csv.file&apos;))
    Files.write(file.toPath(), row.getBytes(StandardCharsets.UTF_8), StandardOpenOption.APPEND)
}
</stringProp>
        </JSR223Listener>

        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Create CSV for this run" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>

      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Calculate and append totals (Groovy)" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Append endpoint totals and the complete run total to the SAME CSV.
import java.nio.file.Files
import java.nio.file.StandardOpenOption
import java.nio.charset.StandardCharsets

// End measurement before summary generation. Includes ramp-up and CSV writes,
// from setup completion until the main user group has finished.
def elapsed = (System.nanoTime() - (props.get(&apos;employee.csv.runStartNs&apos;) as long)) / 1000000L
synchronized (props) {
    def stats = props.get(&apos;employee.csv.stats&apos;)
    def rows = []
    def timestamp = java.time.Instant.now().toString()
    long count = 0L
    long total = 0L
    boolean success = true
    stats.each { name, entry -&gt;
        count += entry.count
        total += entry.total
        success = success &amp;&amp; entry.success
        rows.add([timestamp, name, &apos;&apos;, &apos;&apos;, &apos;&apos;, &apos;&apos;, entry.success, &apos;&apos;, &apos;&apos;,
            &apos;ENDPOINT_TOTAL&apos;, entry.count, entry.total, entry.last - entry.first])
    }
    rows.add([timestamp, &apos;ALL ENDPOINTS&apos;, &apos;&apos;, &apos;&apos;, &apos;&apos;, &apos;&apos;, success, &apos;&apos;, &apos;&apos;,
        &apos;RUN_TOTAL&apos;, count, total, elapsed.longValue()])
    def text = rows.collect { values -&gt;
        [4, 11, 12].each { index -&gt;
            if (values[index] != &apos;&apos;) values[index] = values[index].toString() + &apos; ms&apos;
        }
        values.collect { value -&gt; &apos;&quot;&apos; + (value == null ? &apos;&apos; : value.toString()).replace(&apos;&quot;&apos;, &apos;&quot;&quot;&apos;) + &apos;&quot;&apos; }.join(&apos;,&apos;)
    }.join(&apos;\n&apos;) + &apos;\n&apos;
    Files.write(new File(props.getProperty(&apos;employee.csv.file&apos;)).toPath(),
        text.getBytes(StandardCharsets.UTF_8), StandardOpenOption.APPEND)
}
SampleResult.setIgnore()
</stringProp>
        </JSR223Sampler>
